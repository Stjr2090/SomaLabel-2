# ====================================================================
# SomaLabel Environment Variables
# Note: Never commit real API keys or secrets to version control.
# ====================================================================

# GROQ_API_KEY: Primary label reader. Text-only, so it receives the OCR
# text, never the photo. Required for the fast path.
GROQ_API_KEY="YOUR_GROQ_API_KEY"

# GROQ_MODEL: Groq model used to structure the label.
GROQ_MODEL="openai/gpt-oss-120b"

# GROQ_API_URL: Groq chat-completions endpoint.
GROQ_API_URL="https://api.groq.com/openai/v1/chat/completions"

# GEMINI_API_KEY: Fallback label reader (Gemma 4 via the Gemini API) and the
# only provider that can look at the photo when OCR finds no usable text.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# MODEL_ID: Gemma fallback / vision model identifier.
# Supported options: gemma-4-26b-a4b-it, gemma-4-31b-it
MODEL_ID="gemma-4-26b-a4b-it"

# SUNBIRD_API_KEY: Optional. Sunbird AI API key for translating into Luganda.
SUNBIRD_API_KEY=""

# SUNBIRD_API_URL: Optional. Sunbird AI translation endpoint.
# Defaults to https://api.sunbird.ai/tasks/translate
SUNBIRD_API_URL="https://api.sunbird.ai/tasks/translate"

# PORT: Server listener port (defaults to 3000)
PORT=3000
