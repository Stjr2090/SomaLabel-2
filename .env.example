# ====================================================================
# SomaLabel Environment Variables
# Note: Never commit real API keys or secrets to version control.
# ====================================================================

# GEMINI_API_KEY: Required to access Gemma 4 open-weight models via Gemini API.
# In AI Studio, this is injected automatically from the Secrets panel.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# MODEL_ID: Open-weight Gemma 4 instruction-tuned model identifier.
# Supported options: gemma-4-26b-a4b-it, gemma-4-31b-it
MODEL_ID="gemma-4-26b-a4b-it"

# SUNBIRD_API_KEY: Optional. Sunbird AI API key for translating into Luganda.
SUNBIRD_API_KEY=""

# SUNBIRD_API_URL: Optional. Sunbird AI translation endpoint.
# Defaults to https://api.sunbird.ai/tasks/nllb_translate
SUNBIRD_API_URL="https://api.sunbird.ai/tasks/nllb_translate"

# PORT: Server listener port (defaults to 3000)
PORT=3000
